config {
  type: "view",
  schema: "flight_staging",
  description: "Silver staging view: clean datatypes, unnest flight legs, and generate itinerary surrogate keys"
}

WITH raw_source AS (
  SELECT
    -- Hive partition column from GCS path (dt=YYYY-MM-DD)
    CAST(dt AS DATE) AS scraped_at_date,

    -- Extract itinerary dimensions from flights array and query metadata
    COALESCE(flights[SAFE_OFFSET(0)].from_airport.code, _query_meta.origin) AS origin_airport,
    COALESCE(flights[SAFE_OFFSET(0)].to_airport.code, _query_meta.destination) AS destination_airport,
    PARSE_DATE('%Y-%m-%d', _query_meta.outbound_date) AS outbound_date,
    SAFE.PARSE_DATE('%Y-%m-%d', _query_meta.return_date) AS return_date,
    ARRAY_TO_STRING(airlines, ', ') AS airlines,

    -- Construct departure time (hours and minutes)
    TIME(
      flights[SAFE_OFFSET(0)].departure.time[SAFE_OFFSET(0)],
      flights[SAFE_OFFSET(0)].departure.time[SAFE_OFFSET(1)],
      0
    ) AS outbound_departure_time,
    CAST(flights[SAFE_OFFSET(0)].duration AS INT64) AS outbound_duration_mins,

    -- Return leg placeholder (for multi-leg or one-way tracking)
    CAST(NULL AS TIME) AS return_departure_time,
    CAST(NULL AS INT64) AS return_duration_mins,

    -- Price & Metadata
    CAST(price AS NUMERIC) AS price,
    COALESCE(_query_meta.seat, 'economy') AS seat_class,
    COALESCE(_query_meta.currency, 'EUR') AS currency,
    COALESCE(_query_meta.trip, 'round-trip') AS trip_type,
    'google_flights' AS data_source
  FROM
    ${ref("ext_google_flights")}
  WHERE
    type != 'seed'
    AND (
      '${dataform.projectConfig.vars.trip_type}' = ''
      OR COALESCE(_query_meta.trip, 'round-trip') = '${dataform.projectConfig.vars.trip_type}'
    )
)

SELECT
  -- Deterministic surrogate key identifying unique physical flight itineraries
  TO_HEX(MD5(CONCAT(
    origin_airport, '|',
    destination_airport, '|',
    CAST(outbound_date AS STRING), '|',
    COALESCE(CAST(return_date AS STRING), ''), '|',
    airlines, '|',
    trip_type, '|',
    COALESCE(CAST(outbound_departure_time AS STRING), ''), '|',
    COALESCE(CAST(return_departure_time AS STRING), '')
  ))) AS flight_itinerary_key,

  *
FROM
  raw_source
